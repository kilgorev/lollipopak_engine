{
    "name": "ParticleActor",
    "components": {
        "basic_particles": {
            "type": "ParticleSystem",
            "frames_between_bursts": 1,
            "duration_frames": 60,
            "emit_radius_max": 0.0,
            "start_scale_min": 4.0,
            "start_scale_max": 4.0,
            "end_color_r": 150,
            "end_color_g": 50,
            "end_color_b": 10,
            "end_color_a": 255,
            "start_speed_min": 0.04,
            "start_speed_max": 0.04,
            "end_scale": 0.0
        }
    }
}
ParticleController = {
	ps = nil,

	OnUpdate = function(self)
		if Application.GetFrame() == 10 then
			local particle_actor = Actor.Instantiate("particle_actor")
			self.ps = particle_actor:GetComponent("ParticleSystem")
		end

		if Application.GetFrame() == 100 then
			self.ps:Stop()
		end


		if Application.GetFrame() == 130 then
			self.ps:Play()
		end
	end
}

{
  "game_title": "testcase 3-4",
  "initial_scene":"basic"
}
{
  "clear_color_r": 0,
  "clear_color_g": 0,
  "clear_color_b": 0,
  "x_resolution": 640,
  "y_resolution": 360
}
{
    "actors": [
        {
            "name": "ParticleController",
            "components": {
                "ParticleController": {
                    "type": "ParticleController"
                }
            }
        }
    ]
}
